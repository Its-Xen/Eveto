# ----------------------------------------
# Core App Settings
# ----------------------------------------
APP_NAME=EVETO
APP_ENV=dev
APP_LOG_LEVEL=info

# ----------------------------------------
# PostgreSQL (SQLAlchemy Async)
# ----------------------------------------
APP_DB__HOST=postgres
APP_DB__PORT=5432
APP_DB__USER=eveto_user
APP_DB__PASSWORD=changeme_db_password
APP_DB__NAME=eveto_db
APP_DB__POOL_SIZE=20
APP_DB__MAX_OVERFLOW=10

# ----------------------------------------
# Redis (Cache & Dramatiq Broker)
# ----------------------------------------
APP_REDIS__URL=redis://redis:6379/0
APP_REDIS__CACHE_TTL=3600

# ----------------------------------------
# Auth (JWT RS256)
# ----------------------------------------
APP_JWT__ALGORITHM=RS256
APP_JWT__ACCESS_TOKEN_EXPIRE_MINUTES=30
APP_JWT__PRIVATE_KEY_PATH=./certs/private.pem
APP_JWT__PUBLIC_KEY_PATH=./certs/public.pem

# ----------------------------------------
# Mock Payment Provider
# ----------------------------------------
APP_MOCK_PAYMENT__BASE_URL=http://mock_payment_provider:8000
APP_MOCK_PAYMENT__API_KEY=changeme_mock_token

# ----------------------------------------
# OpenTelemetry (Tracing)
# ----------------------------------------
APP_OTEL__ENDPOINT=http://otel-collector:4317
APP_OTEL__SERVICE_NAME=eveto-api